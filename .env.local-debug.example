# =============================================================================
# .env.local-debug.example
#
# Dùng khi chạy BACKEND BẰNG TERMINAL (uvicorn/uv), KHÔNG dùng Docker cho
# backend, còn hạ tầng (mock-ev-system, redis) chạy bằng
# docker-compose.infra.yaml và expose ra localhost.
#
# Cách dùng:
#   1. copy file này thành .env ở GỐC repo (backend, frontend và compose đều
#      chỉ đọc .env gốc; mẫu đầy đủ theo mục ở .env.example)
#   2. sửa OPENAI_API_KEY / DATABASE_* nếu cần
#   3. docker compose -f docker-compose.infra.yaml up -d
#   4. cd backend && uv run uvicorn src.main:app --reload --port 8000
# =============================================================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- LLM ----
OPENAI_API_KEY=sk-your-key-here

# ---- Database (bỏ trống DATABASE_PASSWORD để fallback SQLite ./data/app.db,
#      hoặc điền thông tin Supabase như mục BACKEND — Database trong .env.example) ----
# DATABASE_URL=

# ---- Mock EV system (container expose ra localhost:8100) ----
OEM_API_BASE_URL=http://localhost:8100
OEM_API_TIMEOUT_SECONDS=8
# HMAC secret for incoming OEM webhooks (API-VEH-004). Empty = every webhook is
# rejected; the hourly poll still syncs data.
OEM_WEBHOOK_SECRET=change-me

# ---- Redis (container expose ra localhost:6379, không đặt password) ----
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_KEY_PREFIX=p146
# Celery broker/result backend: empty -> redis://localhost:6379/0 and /1
REDIS_BROKER_URL=
REDIS_BACKEND_URL=

# ---- Qdrant Cloud (API key chi dien trong .env cuc bo) ----
VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ev_care_knowledge_base
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=3072

# ---- Onboarding rules ----
ONBOARDING_RETENTION_DAYS=15
VEHICLE_VERIFY_MAX_FAILED_ATTEMPTS=5
CONSENT_POLICY_VERSION=2026-09
