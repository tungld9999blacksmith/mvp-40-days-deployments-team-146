# EV Care — cấu hình cục bộ
# Backend và frontend cùng đọc file này ở gốc repository.
# Biến trong môi trường tiến trình có thể ghi đè giá trị ở đây.
# Khởi động lại BE/FE sau khi sửa cấu hình.

# ========================================================================
# 01. Ứng dụng, cổng và CORS
# ========================================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ========================================================================
# 02. Database và Alembic
# ========================================================================
DATABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USER=postgres.rdgbpwlackvilqnmxsjm
DATABASE_PASSWORD=
DATABASE_SSLMODE=require
ALEMBIC_DATABASE_URL=
SUPABASE_PASSWORD=
SUPABASE_CONNECTION_STRING=

# ========================================================================
# 03. Supabase và lưu trữ file
# ========================================================================
FILE_STORAGE=supabase
SUPABASE_URL=https://rdgbpwlackvilqnmxsjm.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# ========================================================================
# 04. Redis
# ========================================================================
# REDIS_URL có giá trị sẽ được ưu tiên; để trống thì dùng các biến REDIS_* riêng.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_KEY_PREFIX=p146
# Transactional outbox (backend/guide/outbox.md): worker quét bảng outbox_event mỗi N giây,
# và được đánh thức ngay sau commit có publish event. Các biến OUTBOX_* khác: xem guide.
OUTBOX_DISPATCH_INTERVAL_SECONDS=10
OUTBOX_WAKEUP_ENABLED=true

# ========================================================================
# 05. Firebase backend và onboarding
# ========================================================================
# FIREBASE_CREDENTIAL là tên file trong backend/src/assets/secrets/.
FIREBASE_CREDENTIAL=mvp-40-days-firebase-adminsdk-fbsvc-bee8af5557.json
ONBOARDING_RETENTION_DAYS=15
VEHICLE_VERIFY_MAX_FAILED_ATTEMPTS=5
CONSENT_POLICY_VERSION=2026-09

# ========================================================================
# 06. Hệ thống hãng xe và tài khoản mock
# ========================================================================
# Các biến MOCK_* dành cho hệ thống hãng xe giả lập, không bật mock API trong frontend.
OEM_API_BASE_URL=http://localhost:8100
OEM_API_TIMEOUT_SECONDS=8
OEM_WEBHOOK_SECRET=
MOCK_SC01_MANAGER_EMAIL=trungmv2004@gmail.com
MOCK_SC02_MANAGER_EMAIL=
MOCK_SC03_MANAGER_EMAIL=
MOCK_OWN001_EMAIL=trungmv2004@gmail.com
# X-Admin-Token của API admin mock (trùng MOCK_ADMIN_TOKEN của mock); backend dùng khi reset tài khoản dùng thử.
OEM_ADMIN_TOKEN=

# Xác thực M2M bất đối xứng giữa EV Care Backend và mock-ev-system (SPEC-SEC-OEM-M2M-001 v2.0):
# backend ký client assertion -> mock cấp access token (cache Redis) -> dùng cho mọi API của mock.
# Hỗ trợ định dạng chuỗi PEM 1 dòng (với \n) hoặc multi-line. Thuật toán: Ed25519 (EdDSA) hoặc RS256.
# 1. Phía EV Care Backend:
EVCARE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIHwHzbyXcaJsUwITibOEQ54DojiiJ/hcbxOcq5LywB39\n-----END PRIVATE KEY-----"
OEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAfg9tLlU37G9x29RkaSE2O3zfV7G9AkquZK1IbdeMff4=\n-----END PUBLIC KEY-----"
# Chế độ xác thực Webhook: "both" (chấp nhận cả JWT và HMAC), "jwt" (bắt buộc M2M JWT), "hmac" (chỉ nhận HMAC cũ)
OEM_AUTH_MODE=both
# Làm mới access token OEM trước khi hết hạn (giây): TTL cache Redis = expires_in - giá trị này
OEM_ACCESS_TOKEN_REFRESH_MARGIN_SECONDS=60

# 2. Phía mock-ev-system (hệ thống hãng xe):
MOCK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIAjSqlQIFeHBA9miyhN/whaEMEinchJ92SJbKMRjseZZ\n-----END PRIVATE KEY-----"
EVCARE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAnHXmiHfQMLghHEzCnECtSBeMQWH23OxtKq52rpTH5z8=\n-----END PUBLIC KEY-----"
# Bắt buộc xác thực M2M: true/false. Mặc định false sẽ bypass khi chưa cấu hình EVCARE_PUBLIC_KEY
MOCK_AUTH_REQUIRED=false
# Thời hạn access token do mock cấp ở POST /oauth/token (giây)
MOCK_ACCESS_TOKEN_TTL_SECONDS=900

# Tài khoản dùng thử dùng chung (nút "Dùng thử ngay" ở màn đăng nhập chủ xe), mặc định tắt.
# Bật cả DEMO_LOGIN_ENABLED (backend) và VITE_DEMO_LOGIN_ENABLED (frontend). DEMO_ACCOUNT_EMAIL
# phải trùng MOCK_DEMO_OWNER_EMAIL của mock (chủ xe OWN-DEMO có VF3, VF8, VF Wild).
DEMO_LOGIN_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo@evcare.invalid
MOCK_DEMO_OWNER_EMAIL=demo@evcare.invalid
DEMO_RESET_INTERVAL_HOURS=48
DEMO_SESSION_RATE_LIMIT_PER_HOUR=20
DEMO_CHAT_RATE_LIMIT_PER_MINUTE=10
DEMO_CHAT_RATE_LIMIT_PER_DAY=30
DEMO_CHAT_TOTAL_PER_DAY=300
# Đọc IP khách từ X-Forwarded-For; chỉ bật sau proxy tin cậy (Railway), nếu không mọi khách chung một IP.
RATE_LIMIT_TRUST_FORWARDED=false

# ========================================================================
# 07. LLM: provider, model và kiểm tra booking
# ========================================================================
# Provider chọn dịch vụ; các biến *_MODEL chọn model trong dịch vụ đó.
# LLM_BOOKING_* điều khiển bước LLM kiểm tra lời gọi tool.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AGENT_MODEL=mistralai/mistral-small-2603
OPENROUTER_AGENT_ENDPOINT_ORDER=mistral/us,mistral/eu
OPENROUTER_REWRITE_MODEL=mistralai/mistral-small-2603
OPENROUTER_REWRITE_ENDPOINT_ORDER=mistral/us,mistral/eu
OPENROUTER_RAG_MODEL=mistralai/mistral-small-2603
OPENROUTER_RAG_ENDPOINT_ORDER=mistral/us,mistral/eu
OPENROUTER_WRITE_MODEL=mistralai/mistral-small-2603
OPENROUTER_WRITE_ENDPOINT_ORDER=mistral/us,mistral/eu
LLM_BOOKING_PROVIDER=openrouter
LLM_BOOKING_MODEL=mistralai/mistral-small-2603
LLM_BOOKING_CHECK_ENABLED=true
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ========================================================================
# 08. RAG: embedding và vector store
# ========================================================================
# Model embedding và số chiều phải khớp dữ liệu đã ingest trong collection.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_OPENROUTER_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
VECTOR_STORE=qdrant
QDRANT_URL=https://f97ec06f-5904-4181-8e20-08dbc6c7ba5a.australia-southeast1-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ev_care_knowledge_base_3072
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma

# ========================================================================
# 09. Checkpoint, memory và lịch sử chat
# ========================================================================
# Áp migration trước khi sử dụng memory; các cờ read/write điều khiển ghi nhớ sở thích.
AGENT_CHECKPOINT_MODE=postgres
# on còn chặn nhầm lượt chat có tool result do graph tự chèn ("Orphan tool result"); giữ off/shadow tới khi sửa.
AGENT_MEMORY_CONTEXT_MODE=off
AGENT_MEMORY_READ_ENABLED=true
AGENT_MEMORY_WRITE_ENABLED=true
AGENT_MEMORY_CANARY_USER_IDS=[]
# System prompt + schema tool đã ~12k token; budget phải chừa chỗ cho lịch sử và kết quả tool.
AGENT_MEMORY_INPUT_TOKEN_BUDGET=20000
AGENT_MEMORY_SUMMARY_TRIGGER_RATIO=0.75
AGENT_MEMORY_SUMMARY_MAX_TOKENS=1000
AGENT_MEMORY_RECENT_TURNS=6
AGENT_MEMORY_RECALL_MAX_TOKENS=500
AGENT_MEMORY_CONTEXT_WINDOW=32768
AGENT_MEMORY_OUTPUT_RESERVE=2048
AGENT_MEMORY_PREFERENCE_RETENTION_DAYS=180
AGENT_MEMORY_RETENTION_ENABLED=false
CONVERSATION_SEMANTIC_INDEX_ENABLED=false

# ========================================================================
# 10. Email của backend thật
# ========================================================================
REMINDER_DEFAULT_LEAD_DAYS=2
REMINDER_JOB_HOUR=8
REMINDER_MAX_ATTEMPTS=3
# Cá nhân hoá chỉ hoạt động khi chủ xe opt-in riêng ở Cài đặt thông báo.
# on: nhắc dự báo; shadow: đánh giá so với luật cố định; off: tắt toàn bộ forecast.
PERSONALIZED_REMINDERS_MODE=shadow
# Canary với mode on: chỉ các owner ID trong danh sách được nhắc dự báo;
# owner opt-in ngoài nhóm vẫn ở shadow. Để trống khi mở cho mọi owner opt-in.
PERSONALIZED_REMINDERS_CANARY_USER_IDS=
# Ngưỡng lọc tốc độ ODO bất thường, không phải giới hạn kỹ thuật của xe.
USAGE_MAX_DAILY_KM=1000

# Gửi email nhắc bảo dưỡng qua Resend; dùng domain gửi đã xác minh và webhook đã cấu hình.
EMAIL_MODE=resend
EMAIL_APP_URL=http://localhost:5173
EMAIL_FROM='EV Care <onboarding@resend.dev>'
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_PAYLOAD_RETENTION_DAYS=30

# ========================================================================
# 11. Tìm địa điểm và AWS Places
# ========================================================================
# LOCATION_PROVIDER chọn provider; AWS key backend được giữ ngoài các biến VITE_*.
LOCATION_PROVIDER=fake
AWS_LOCATION_REGION=ap-southeast-2
AWS_LOCATION_PLACES_API_KEY=
LOCATION_TIMEOUT_SECONDS=3
LOCATION_SUGGEST_RATE_PER_MINUTE=30
LOCATION_DETAIL_RATE_PER_MINUTE=20
LOCATION_REVERSE_RADIUS_METERS=500

# ========================================================================
# 12. Frontend: Firebase, API, chat và bản đồ
# ========================================================================
# Các biến VITE_* được đưa vào frontend; chỉ đặt cấu hình dành cho trình duyệt ở đây.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mvp-40-days.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mvp-40-days
VITE_FIREBASE_APP_ID=1:537563199343:web:e6fe4e3ada923b598e5a9a
VITE_FIREBASE_AUTH_EMULATOR_URL=
VITE_CONSENT_POLICY_VERSION=2026-09
VITE_WORKSHOP_CONSENT_POLICY_VERSION=WS-2026-09
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_CHAT_TRANSPORT=http
VITE_API_MOCKS=off
VITE_CHAT_WS_ENABLED=false
VITE_SUPPORT_URL=
VITE_AWS_LOCATION_REGION=ap-southeast-2
VITE_AWS_LOCATION_MAP_API_KEY=
VITE_DEMO_LOGIN_ENABLED=false

# ========================================================================
# 13. Logging, tracing và AI log
# ========================================================================
LOG_LEVEL=INFO

LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
# Celery worker LLM runs (summaries, follow-ups) — own project, keeps the chat quota view clean.
LANGCHAIN_JOBS_PROJECT=evcare-dev-jobs
# Mask emails / phones in every LangSmith input / output (on for staging, off for local debugging).
LANGCHAIN_REDACT_PII=false
LANGCHAIN_TRACING_V2=true

AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# 14. Two-tier pricing for NEW bookings (docs/designs/bao-gia-hai-tang.md); legacy to switch back
QUOTE_FLOW=two_tier

# LangSmith region APAC (UI: apac.smith.langchain.com). Service keys per environment.
LANGCHAIN_ENDPOINT=https://apac.api.smith.langchain.com
LANGCHAIN_API_KEY=
# Service keys are org-scoped: the workspace must be named or every call returns 403.
LANGCHAIN_WORKSPACE_ID=
LANGCHAIN_PROJECT=evcare-dev
LANGCHAIN_TRACING_V2=true

# ======================================================================
# OBSERVABILITY — Grafana Cloud (OTLP), stack eagerscone770, region ap-southeast-1
# Used by the OTel Collector only; the app sends OTLP to the collector, not here.
# ======================================================================
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-southeast-1.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# ---- App -> OTel Collector (backend + worker). true only while the collector runs
#      (docker compose ... --profile observability). docs/observability/OBSERVABILITY_SETUP.md
OTEL_ENABLED=false
# Grafana side of the AI agent (spans, metrics: latency / tokens / cost). Needs OTEL_ENABLED=true.
# LangSmith tracing is independent of this switch. docs/observability/AGENT_COST_LATENCY.md
OTEL_AGENT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_DEPLOYMENT_ENVIRONMENT=dev
