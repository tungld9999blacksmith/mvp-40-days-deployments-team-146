# EV Care — biến môi trường DUY NHẤT cho cả repo (backend, frontend, docker compose).
# Copy thành .env ở gốc repo rồi điền giá trị. KHÔNG commit .env.
# Mẫu chạy backend thật: PostgreSQL, Redis, Mistral/OpenRouter, Gemini embedding,
# memory và reviewer bật; email qua Resend sau khi điền key/domain đã xác minh.
# Chạy migration từ backend/: uv run alembic upgrade head.

# ======================================================================
# CHUNG — ứng dụng
# ======================================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# true = dòng log JSON (structlog), false = log dễ đọc trên console
LOG_JSON=true
# Che bí mật / PII (email, SĐT, bearer token, API key) trong mọi log
LOG_REDACT_PII=true
# Ghi log ra file: tập con của log,json,csv (trống = chỉ stdout)
LOG_FILE_FORMATS=log
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
# CORS cho phép hợp của CORS_ORIGINS (phân tách bằng dấu phẩy) và FRONTEND_URL.
# FRONTEND_URL còn dùng cho link trong email và QR. "*" ở một trong hai biến = tắt giới hạn CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ======================================================================
# BACKEND — Database (Supabase Postgres), dùng cho checkpoint và memory.
# Nếu không cấu hình Postgres, backend có thể chọn SQLite; checkpoint postgres
# trong mẫu này cần kết nối PostgreSQL hợp lệ.
# ======================================================================
# Để trống thì backend tự ghép URL từ DATABASE_HOST/PORT/USER/PASSWORD bên dưới.
# Nếu điền, DATABASE_URL sẽ ĐÈ các trường lẻ đó.
DATABASE_URL=
DATABASE_HOST=db.<project-ref>.supabase.co
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=<database-password>
DATABASE_SSLMODE=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-or-service-key>

# ---- File storage (Supabase Storage). Bucket phải tồn tại, để private ----
FILE_STORAGE=supabase
SUPABASE_STORAGE_BUCKET=documents
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# ======================================================================
# BACKEND — Firebase Admin: TÊN FILE khoá service account đặt trong
# backend/src/assets/secrets/ (thư mục đã bị .gitignore)
# ======================================================================
FIREBASE_CREDENTIAL=<ten-file-adminsdk>.json

# ======================================================================
# BACKEND — Redis (cache / lock / pub-sub / Celery). REDIS_URL đè các trường lẻ.
# ======================================================================
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=
REDIS_KEY_PREFIX=p146
REDIS_DEFAULT_CACHE_TTL=300
REDIS_BROKER_URL=
REDIS_BACKEND_URL=
CELERY_BROKER_DB=0
CELERY_BACKEND_DB=1

# ======================================================================
# BACKEND — Vector store RAG (Qdrant). Để trống QDRANT_URL thì lưu
# Qdrant Local tại ./data/qdrant_local
# ======================================================================
# Qdrant Cloud: https://cloud.qdrant.io
VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ev_care_knowledge_base_3072
# Must match the model and dimensions used to ingest the knowledge collection.
# openrouter (OPENROUTER_API_KEY) | gemini (GEMINI_API_KEY) | openai | huggingface | local.
# After changing provider/model, re-embed: python scripts/ingest_knowledge.py --force
EMBEDDING_PROVIDER=gemini
EMBEDDING_GEMINI_MODEL=gemini-embedding-001
# Chỉ dùng khi đổi EMBEDDING_PROVIDER sang openrouter.
EMBEDDING_OPENROUTER_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# ======================================================================
# BACKEND — Hệ thống hãng xe (OEM / mock-ev-system) và trạng thái bảo dưỡng
# ======================================================================
OEM_API_BASE_URL=http://localhost:8100
OEM_API_TIMEOUT_SECONDS=8
# HMAC secret dùng chung với mock-ev-system (MOCK_WEBHOOK_SECRET)
OEM_WEBHOOK_SECRET=change-me

# Mock OEM: Gmail được ghi nhận là quản lý xưởng SC-01/02/03 (đăng nhập Workshop Portal).
# Để trống = email mẫu trong seed. Đổi xong: docker compose -f docker-compose.infra.yaml up -d mock-ev-system
MOCK_SC01_MANAGER_EMAIL=
MOCK_SC02_MANAGER_EMAIL=
MOCK_SC03_MANAGER_EMAIL=
# Mock OEM: Gmail của chủ xe OWN-001 (2 xe VF5PLUS2024000001, VF8ECO20230000001)
MOCK_OWN001_EMAIL=
# Mock OEM: Gmail dev — mỗi email tự có chủ xe + xe + ODO + bảo hành + lịch sử bảo dưỡng
# khi mock khởi động. Nhiều email cách nhau dấu phẩy; CCCD cố định thêm sau dấu ":".
# Vd: MOCK_DEV_OWNER_EMAILS=you@gmail.com,teammate@gmail.com:079200009999 — xem DEV_GUIDE.md
MOCK_DEV_OWNER_EMAILS=
# Số xe tạo cho mỗi email (mặc định 2)
MOCK_DEV_OWNER_VEHICLES=2
# Ngày tham chiếu cố định để tính ODO / ngày SX / trạng thái bảo hành (trống = 2026-09-01)
MOCK_DEV_REFERENCE_DATE=
# ODO: static = gán một ODO ngẫu nhiên cố định cho mỗi xe (demo, không kéo từ OEM);
# oem = đồng bộ từ OEM (Celery). Để trống: static khi APP_ENV khác production, oem ở production.
OEM_SYNC_MODE=
OEM_SYNC_INTERVAL_SECONDS=7200
OEM_SYNC_ALERT_FAILURES=3
OEM_WEBHOOK_TOLERANCE_SECONDS=300
DUE_SOON_KM=500
DUE_SOON_DAYS=14
MAINTENANCE_RECURRING_MONTHS=12
ODO_STALE_DAYS=30
# Luồng báo giá cho booking MỚI (docs/designs/bao-gia-hai-tang.md):
# legacy = báo giá xưởng duyệt trước (us-049); two_tier = giá gói chốt lúc đặt lịch + chủ xe duyệt phát sinh.
# Mỗi booking giữ luồng lúc tạo, nên đổi lại legacy không ảnh hưởng booking two_tier đang mở.
QUOTE_FLOW=legacy
# Bucket Supabase Storage RIÊNG TƯ cho ảnh phát sinh (5 MB, jpeg/png/webp; xem đường dẫn ký 10 phút)
BOOKING_LINE_PHOTO_BUCKET=booking-line-photos

# ======================================================================
# BACKEND — Nhắc bảo dưỡng và email
# ======================================================================
REMINDER_DEFAULT_LEAD_DAYS=2
REMINDER_JOB_HOUR=8
REMINDER_MAX_ATTEMPTS=3
# Email backend thật: resend | mock | off; độc lập với DEMO_EMAIL_MODE.
# resend cần RESEND_API_KEY, EMAIL_FROM dùng domain đã xác minh và RESEND_WEBHOOK_SECRET.
# Dùng mock để xem bản nháp khi chưa cấu hình Resend; off để tắt kênh gửi email.
EMAIL_MODE=resend
EMAIL_FROM=EV Care <reminders@your-verified-domain.example>
EMAIL_APP_URL=http://localhost:5173
EMAIL_PAYLOAD_RETENTION_DAYS=30
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ======================================================================
# BACKEND — Agent checkpoint và memory
# ======================================================================
# postgres lưu hội thoại qua lần khởi động lại; chạy migration trước khi bật backend.
# auto chọn theo database; memory chỉ lưu checkpoint trong RAM cho kiểm thử.
AGENT_CHECKPOINT_MODE=postgres
# on bật quản lý context; shadow chỉ đo; off tắt quản lý context.
# Đọc/ghi sở thích được điều khiển riêng bởi AGENT_MEMORY_READ/WRITE_ENABLED.
AGENT_MEMORY_CONTEXT_MODE=on
AGENT_MEMORY_INPUT_TOKEN_BUDGET=12000
AGENT_MEMORY_SUMMARY_TRIGGER_RATIO=0.75
AGENT_MEMORY_SUMMARY_MAX_TOKENS=1000
AGENT_MEMORY_RECENT_TURNS=6
AGENT_MEMORY_RECALL_MAX_TOKENS=500
# Set to the selected model's actual window and sufficient output reserve.
AGENT_MEMORY_CONTEXT_WINDOW=32768
AGENT_MEMORY_OUTPUT_RESERVE=2048
AGENT_MEMORY_READ_ENABLED=true
AGENT_MEMORY_WRITE_ENABLED=true
# JSON list of backend owner IDs; [] keeps global read/write flag behavior.
AGENT_MEMORY_CANARY_USER_IDS=[]
AGENT_MEMORY_PREFERENCE_RETENTION_DAYS=180
# Only enables scheduled retention; manual purge defaults to dry-run.
AGENT_MEMORY_RETENTION_ENABLED=false

# ======================================================================
# BACKEND — SMS và quy tắc onboarding
# ======================================================================
# SMS qua eSMS.vn: kênh chỉ hiện cho chủ xe khi điền đủ ESMS_API_KEY, ESMS_SECRET_KEY và ESMS_BRANDNAME;
# để trống thì vẫn hiện "Sắp có".
# Tin CSKH (SmsType=2) phải khớp mẫu đã đăng ký với eSMS cho brandname (nếu không eSMS trả 146).
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=2
# 0 = bỏ dấu tiếng Việt (160 ký tự/tin), 1 = giữ dấu (70 ký tự/tin)
ESMS_UNICODE=false
# true = eSMS nhận request nhưng không gửi thật, không trừ tiền (để thử)
ESMS_SANDBOX=false
ONBOARDING_RETENTION_DAYS=15
VEHICLE_VERIFY_MAX_FAILED_ATTEMPTS=5
CONSENT_POLICY_VERSION=2026-09

# ======================================================================
# BACKEND — LLM, embedding & LangSmith
# ======================================================================
# Nhà cung cấp LLM của agent chat: openai | gemini | anthropic | grok | deepseek | openrouter
LLM_PROVIDER=openrouter
# Empty stage overrides inherit LLM_PROVIDER and OPENROUTER role models below.
# Explicit LLM_*_MODEL overrides take precedence over OPENROUTER_*_MODEL.
LLM_ORCHESTRATOR_PROVIDER=
LLM_ORCHESTRATOR_MODEL=
LLM_REWRITE_PROVIDER=
LLM_REWRITE_MODEL=
LLM_RAG_PROVIDER=
LLM_RAG_MODEL=
# Reviewer kiểm tra đề xuất booking và thay đổi nhắc bảo dưỡng trước khi gọi tool.
# Không thay bước chủ xe xác nhận hoặc validation backend. Review lỗi thì chặn tool.
LLM_BOOKING_CHECK_ENABLED=true
LLM_BOOKING_PROVIDER=openrouter
LLM_BOOKING_MODEL=mistralai/mistral-small-2603
# gemini = Google AI Studio fallback (needs GEMINI_API_KEY) for rate limit, timeout and 5xx errors.
# Authentication and invalid model/request errors remain visible. Empty = no fallback.
LLM_FALLBACK_PROVIDER=
# Per LLM request. Keep well below CHAT_RUN_TIMEOUT_SECONDS (30) so the fallback still fits.
# With a usable fallback the primary does not retry; a missing fallback key disables the fallback.
LLM_CALL_TIMEOUT_SECONDS=10
# Chỉ cần nếu chuyển provider sang openai; cấu hình mặc định không gọi OpenAI trực tiếp.
# MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
# Key Gemini dùng cho embedding mặc định; chat vẫn dùng OpenRouter/Mistral.
GEMINI_API_KEY=
# Chỉ dùng model chat này nếu chọn provider/fallback/demo Gemini.
GEMINI_MODEL=gemini-3.5-flash-lite
# Dùng khi LLM_PROVIDER=openrouter hoặc stage provider=openrouter.
# Embedding vẫn dùng EMBEDDING_PROVIDER riêng, giữ key tương ứng.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small-2603
# Optional role overrides; blank uses OPENROUTER_MODEL. Evaluator CLI overrides these.
# Agent, Rewrite và RAG dùng cùng baseline Mistral đã kiểm thử.
OPENROUTER_AGENT_MODEL=mistralai/mistral-small-2603
OPENROUTER_REWRITE_MODEL=mistralai/mistral-small-2603
OPENROUTER_RAG_MODEL=mistralai/mistral-small-2603
# Model dự phòng cho stage write; reviewer đang chạy chọn model bằng LLM_BOOKING_MODEL.
OPENROUTER_WRITE_MODEL=mistralai/mistral-small-2603
# Danh sách endpoint theo thứ tự cho từng stage Mistral; trống dùng routing mặc định.
# Khi đổi model/provider, điều chỉnh endpoint tương ứng.
# On HTTP 429, try the next configured endpoint with the same model; retries are bounded.
OPENROUTER_AGENT_ENDPOINT_ORDER=mistral/us,mistral/eu
OPENROUTER_REWRITE_ENDPOINT_ORDER=mistral/us,mistral/eu
OPENROUTER_RAG_ENDPOINT_ORDER=mistral/us,mistral/eu
# Dùng cho booking/reminder reviewer cấu hình bởi LLM_BOOKING_*.
OPENROUTER_WRITE_ENDPOINT_ORDER=mistral/us,mistral/eu
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Giới hạn output mặc định, tránh OpenRouter dành trước toàn bộ context cho output.
OPENROUTER_MAX_TOKENS=1024
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY is an alias for GEMINI_API_KEY, not an OpenRouter key.
# GOOGLE_API_KEY=
# Hỏi thăm sau dịch vụ (AI-007): phân loại nhận xét của chủ xe bằng LLM_PROVIDER ở trên.
# false = chỉ dùng luật từ khoá + điểm; LLM lỗi / quá 5 giây cũng tự rơi về luật.
FOLLOW_UP_LLM_CLASSIFIER_ENABLED=false
# LangSmith: Settings > API Keys > Service Key (lsv2_sk_...), one key per environment.
# Endpoint must match the UI region: smith -> api.smith, eu.smith -> eu.api.smith,
# apac.smith -> apac.api.smith (all .langchain.com).
LANGCHAIN_ENDPOINT=https://apac.api.smith.langchain.com
LANGCHAIN_API_KEY=
# Service keys are org-scoped: set the workspace ID (Settings > Workspaces) or calls return 403.
LANGCHAIN_WORKSPACE_ID=
LANGCHAIN_PROJECT=evcare-dev
# Enable tracing only after supplying a LangSmith key.
LANGCHAIN_TRACING_V2=false

# ======================================================================
# BACKEND — Tìm vị trí (Amazon Location Service, dữ liệu GrabMaps)
# docs/specs/platform/location-search.api.md. GrabMaps CHỈ có ở ap-southeast-1 / ap-southeast-5:
# key tạo ở region khác (vd ap-southeast-2) trả dữ liệu của nhà cung cấp khác.
# ======================================================================
# fake = dữ liệu cố định, không gọi AWS (dev, test, demo); aws = gọi Amazon Location thật
LOCATION_PROVIDER=fake
AWS_LOCATION_REGION=ap-southeast-1
# Server key: chỉ cấp geo-places:Suggest, geo-places:GetPlace, geo-places:ReverseGeocode. Không đưa ra frontend.
AWS_LOCATION_PLACES_API_KEY=
LOCATION_TIMEOUT_SECONDS=3
LOCATION_SUGGEST_RATE_PER_MINUTE=30
LOCATION_DETAIL_RATE_PER_MINUTE=20
LOCATION_REVERSE_RADIUS_METERS=500

# ======================================================================
# TOOLING — AI log (do giảng viên cấp)
# ======================================================================
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ======================================================================
# FRONTEND — chỉ biến có tiền tố VITE_ được Vite đưa vào trình duyệt
# (Vite đọc file này nhờ envDir: '..'). KHÔNG đặt bí mật ở đây.
# ======================================================================
# Firebase Web app: Firebase Console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_APP_ID=
# Tuỳ chọn: Firebase Auth Emulator, ví dụ http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=
# false = normal UI; emulator also enables demo mode automatically.
VITE_DEMO_MODE=false
# Bản đồ Amazon Location (MapLibre). Map key CÔNG KHAI: chỉ cấp geo-maps:GetTile + geo-maps:GetStyleDescriptor
# và giới hạn referer (domain Vercel, http://localhost:5173/*). Khác với AWS_LOCATION_PLACES_API_KEY.
VITE_AWS_LOCATION_REGION=ap-southeast-1
VITE_AWS_LOCATION_MAP_API_KEY=
# Phải khớp CONSENT_POLICY_VERSION / WORKSHOP_CONSENT_POLICY_VERSIONS của backend
VITE_CONSENT_POLICY_VERSION=2026-09
VITE_WORKSHOP_CONSENT_POLICY_VERSION=WS-2026-09
# "http" = API hội thoại thật (API-CHAT-004, SSE); "mock" = dữ liệu giả, không cần backend
VITE_CHAT_TRANSPORT=http
VITE_CHAT_WS_ENABLED=false
# Mock API trong trình duyệt (chỉ để demo khi không chạy backend). Mọi nhóm đã có backend thật.
# off (mặc định) | all | danh sách nhóm: estimate,bookings,board,crm
VITE_API_MOCKS=off
VITE_SUPPORT_URL=
# Đích proxy /api của Vite dev server (mặc định http://localhost:8000)
VITE_BACKEND_URL=

# ======================================================================
# DEMO — src.demo.main:app (no SQL/Redis; real Firebase auth + LLM)
# See docs/plans/AGENT_BACKEND_DEMO_PLAN.md for three-terminal startup.
# These settings do not select the entrypoint: start src.demo.main:app explicitly.
# ======================================================================
# Emulator only: uncomment and use the same project in VITE_FIREBASE_PROJECT_ID.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_PROJECT_ID=demo-ev-care
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Empty provider = Gemini when a Gemini key is configured, otherwise OpenAI.
DEMO_LLM_PROVIDER=
# Supported: gemini | openai | openrouter. Empty model uses that provider's configured model.
DEMO_LLM_MODEL=
# Empty = real time. Same-day check-in: today at 09:00, e.g. 2026-10-04T09:00:00+07:00.
DEMO_NOW=
# Defaults: data/demo/registration.json, data/demo/notifications.json (gitignored).
# DEMO_REGISTRATION_FILE=
# DEMO_NOTIFICATIONS_FILE=
# Empty = fixture workshops. Override JSON: {"verified-email@example.com":"workshop-UUID"}
DEMO_WORKSHOP_OWNERS=

# Maintenance reminder email: mock (default) | off | resend | resend_test.
# mock stores previews in the authenticated /notifications/demo-email page; no email leaves the app.
DEMO_EMAIL_MODE=mock
DEMO_EMAIL_APP_URL=http://127.0.0.1:5173
DEMO_REMINDER_INTERVAL_SECONDS=60
# Default: <repo>/data/demo/notifications.json, independent of registration and demo/reset.
# DEMO_NOTIFICATIONS_FILE=D:/ev-care/data/notifications.json
# Only for resend mode, with REAL Firebase authentication (not Auth Emulator) and unset DEMO_NOW:
# RESEND_API_KEY=<your-server-only-api-key>
# DEMO_EMAIL_FROM=EV Care <reminders@your-verified-domain.example>
# RESEND_WEBHOOK_SECRET=whsec_<your-signing-secret>
# resend_test keeps Firebase Auth Emulator and mock business data; sends ONLY via the UI test button.
# Use the same email in the emulator account and DEMO_EMAIL_TEST_TO (one fixed recipient, no display name).
# RESEND_API_KEY and DEMO_EMAIL_FROM are required; webhook secret is optional for delivery tracking.
# Real-clock cooldown is shared by this mailbox; DEMO_NOW only changes the synthetic vehicle schedule.
# Test history defaults to data/demo/notifications-resend-test.json; mock history stays separate.
DEMO_EMAIL_TEST_TO=
# ======================================================================
# OBSERVABILITY — Grafana Cloud (OTLP). Used by the OTel Collector only.
# Grafana Cloud > Connections > OpenTelemetry (OTLP) > Serverless/Others.
# ======================================================================
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
