# ev_mock_data tool settings. Copy this file to `.env` (same folder) and fill it in.
# `.env` is git-ignored; never commit a real token.
# Priority: CLI flags > shell environment variables > this file > defaults.

# mock-ev-system base URL (local: 8100; or the Railway URL of the mock service)
EV_MOCK_URL=http://localhost:8100

# Must equal MOCK_ADMIN_TOKEN of the mock. Leave empty when the mock has no token (local).
EV_MOCK_ADMIN_TOKEN=

# Where generate / seed / export / dump write their files (relative to the repo root)
EV_MOCK_DATA_DIR=tools/ev_mock_data/data
