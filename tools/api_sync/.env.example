# api_sync tool settings. Copy this file to `.env` (same folder) and fill it in.
# `.env` is git-ignored; never commit a real API key.
# Priority: CLI flags > shell environment variables > this file > defaults.

# ---- Schema source ----
# The backend API must be RUNNING before you use the tool: it reads the schema
# from this URL. Start it with: cd backend && uv run uvicorn src.main:app --reload --port 8000
API_SYNC_SOURCE=http://localhost:8000/openapi.json

# ---- Output folders (relative paths are resolved from the repository root) ----
# TypeScript files + sync state (.api-sync/ with manifest, history, snapshots)
API_SYNC_OUT=frontend/src/shared/api/generated
# Sample JSON data generated by the `mock` command
API_SYNC_MOCK_OUT=frontend/src/mocks/generated
# Hints file (meaning of long-text fields for `mock --llm`), created by the `hints` command
API_SYNC_HINTS_FILE=tools/api_sync/api_hints.json

# ---- LLM (only used by `mock --llm` to write long text fields) ----
# openai | anthropic | gemini | grok | deepseek
LLM_PROVIDER=openai
LLM_API_KEY=
# Leave empty for the provider default (openai: gpt-4o-mini, anthropic: claude-haiku-4-5-20251001,
# gemini: gemini-2.5-flash, grok: grok-4, deepseek: deepseek-chat)
LLM_MODEL=
# Optional: any OpenAI-compatible server (Ollama, LM Studio, internal proxy)
LLM_BASE_URL=
