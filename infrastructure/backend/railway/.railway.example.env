# EV Care — biến môi trường BACKEND cho Railway (service backend + worker).
# Sinh từ .env (gốc repo) + file Firebase service account JSON.
# Dán vào Railway: Project Settings > Shared Variables (staging) > Raw Editor.
# Biến frontend (VITE_*) đã bỏ — backend không dùng.

# ======================================================================
# CHUNG — ứng dụng
# ======================================================================
# Railway environment: staging. APP_ENV chỉ nhận development|production|test;
# staging dùng production để tắt bypass header X-User-Id của môi trường dev.
APP_ENV=production
APP_HOST=
APP_PORT=
LOG_LEVEL=
CORS_ORIGINS=
FRONTEND_URL=

# ======================================================================
# BACKEND — Database (Supabase Postgres)
# ======================================================================
# DATABASE_URL để trống: backend ghép kết nối từ DATABASE_HOST/PORT/USER/PASSWORD (Supabase pooler, IPv4)
# DATABASE_URL=
ALEMBIC_DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=
SUPABASE_URL=
SUPABASE_KEY=

# ---- File storage (Supabase Storage). Bucket phải tồn tại, để private ----
FILE_STORAGE=
SUPABASE_STORAGE_BUCKET=
STORAGE_SIGNED_URL_TTL_SECONDS=
SUPABASE_PASSWORD=
SUPABASE_CONNECTION_STRING=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ======================================================================
# BACKEND — Firebase Admin (service account JSON)
# ======================================================================
# Firebase Admin: nội dung file service account JSON (1 dòng). Không có file trong
# backend/src/assets/secrets/ thì setup.py đọc biến này.
FIREBASE_CREDENTIAL_JSON=

# ======================================================================
# BACKEND — Redis
# ======================================================================
# Redis service trên Railway phải tên "Redis" (cùng environment staging).
# Đặt khối này trong Variables của TỪNG service backend + worker (biến tham chiếu ${{...}}).
# Không đặt REDIS_URL / REDIS_BROKER_URL / REDIS_BACKEND_URL: code tự ghép URL từ
# host/port/password và tách DB: cache=REDIS_DB, Celery broker=0, result backend=1.
REDIS_URL=
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_DB=2
REDIS_KEY_PREFIX=p146
REDIS_DEFAULT_CACHE_TTL=300
CELERY_BROKER_DB=0
CELERY_BACKEND_DB=1

# ======================================================================
# BACKEND — Vector store (Chroma)
# ======================================================================

# ======================================================================
# BACKEND — Hệ thống hãng xe (OEM / mock-ev-system)
# ======================================================================
OEM_API_BASE_URL=
OEM_API_TIMEOUT_SECONDS=
OEM_WEBHOOK_SECRET=

# Mock OEM: Gmail được ghi nhận là quản lý xưởng SC-01/02/03 (đăng nhập Workshop Portal).
# Để trống = email mẫu trong seed. Đổi xong: docker compose -f docker-compose.infra.yaml up -d mock-ev-system
MOCK_SC01_MANAGER_EMAIL=
MOCK_SC02_MANAGER_EMAIL=
MOCK_SC03_MANAGER_EMAIL=
# Mock OEM: Gmail của chủ xe OWN-001 (2 xe VF5PLUS2024000001, VF8ECO20230000001)
MOCK_OWN001_EMAIL=
# Mock OEM: Gmail dev — mỗi email tự có chủ xe + xe + ODO + bảo hành + lịch sử bảo dưỡng
# khi mock khởi động. Nhiều email cách nhau dấu phẩy; CCCD cố định thêm sau dấu ":".
# Vd: MOCK_DEV_OWNER_EMAILS=you@gmail.com,teammate@gmail.com:079200009999 — xem DEV_GUIDE.md
MOCK_DEV_OWNER_EMAILS=
# Số xe tạo cho mỗi email (mặc định 2)
MOCK_DEV_OWNER_VEHICLES=

# ======================================================================
# BACKEND — Quy tắc nghiệp vụ onboarding
# ======================================================================
ONBOARDING_RETENTION_DAYS=
VEHICLE_VERIFY_MAX_FAILED_ATTEMPTS=
CONSENT_POLICY_VERSION=

# ======================================================================
# BACKEND — LLM & LangSmith
# ======================================================================
# Key Google (AI Studio) -> dùng Gemini cho agent chat
LLM_PROVIDER=
# Embedding cho RAG/tìm kiếm cũng dùng Gemini (cùng key, 1024 chiều)
EMBEDDING_PROVIDER=
GEMINI_API_KEY=
# Chưa có key OpenAI (sk-...)
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=

# ======================================================================
# TOOLING — AI log
# ======================================================================
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=

VECTOR_STORE=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
EMBEDDING_DIMENSIONS=
