        {
          "uid": "evcare-agent-p95-latency",
          "title": "Agent p95 latency high",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (le) (rate(evcare_agent_turn_duration_seconds_bucket[10m]))) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "prometheus",
                  "uid": "grafanacloud-prom"
                },
                "hide": false,
                "editorMode": "code",
                "legendFormat": "__auto"
              },
              "queryType": ""
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "settings": {
                  "mode": "dropNN"
                },
                "hide": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        15
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "hide": false
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "p95 một lượt chat là {{ humanizeDuration $values.B.Value }} (> 15s)",
            "description": "Xem dashboard \"EV Care — Agent: độ trễ & chi phí\"; chậm ở node/tool nào: panel LLM p95 theo node và Tool p95."
