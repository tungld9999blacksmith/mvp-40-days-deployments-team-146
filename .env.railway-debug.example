# =============================================================================
# .env.railway-debug.example
#
# Dùng khi chạy BACKEND BẰNG TERMINAL trên máy local, còn Redis + mock-ev-system
# chạy trên RAILWAY (xem docs/RUN_LOCAL_BACKEND_RAILWAY.md).
#
# Cách dùng:
#   1. copy các dòng cần thiết vào .env ở GỐC repo (backend, frontend và compose
#      chỉ đọc .env gốc; mẫu đầy đủ theo mục ở .env.example)
#   2. chạy `./scripts/railway-infra.ps1 env -Slot <n>` rồi dán đè các dòng
#      OEM_* / REDIS_* / CELERY_* nó in ra
#   3. sửa OPENAI_API_KEY / DATABASE_* nếu cần
#   4. cd backend && uv run uvicorn src.main:app --reload --port 8000
# =============================================================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- LLM ----
OPENAI_API_KEY=sk-your-key-here

# ---- Database (bỏ trống để fallback SQLite ./data/app.db, hoặc điền Supabase) ----
# DATABASE_URL=

# ---- Mock EV system trên Railway (domain HTTPS công khai của service) ----
OEM_API_BASE_URL=https://mock-ev-system-xxxx.up.railway.app
OEM_API_TIMEOUT_SECONDS=8
# Phải bằng biến MOCK_WEBHOOK_SECRET của service mock-ev-system trên Railway.
OEM_WEBHOOK_SECRET=paste-from-railway

# ---- Redis trên Railway (qua TCP Proxy công khai, KHÔNG phải redis.railway.internal) ----
# Để trống REDIS_URL để backend tự ghép URL theo từng DB (app / Celery broker / result).
REDIS_URL=
REDIS_HOST=xxx.proxy.rlwy.net
REDIS_PORT=12345
# Bọc nháy đơn phòng khi mật khẩu có ký tự đặc biệt.
REDIS_PASSWORD='paste-from-railway'
# Slot 0: broker=0, result=1, app=2. Slot n: broker=3n, result=3n+1, app=3n+2.
REDIS_DB=2
CELERY_BROKER_DB=0
CELERY_BACKEND_DB=1
REDIS_KEY_PREFIX=p146-dev0
REDIS_BROKER_URL=
REDIS_BACKEND_URL=

# ---- Qdrant Cloud (API key chi dien trong .env cuc bo) ----
VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ev_care_knowledge_base
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=3072

# ---- Onboarding rules ----
ONBOARDING_RETENTION_DAYS=15
VEHICLE_VERIFY_MAX_FAILED_ATTEMPTS=5
CONSENT_POLICY_VERSION=2026-09
